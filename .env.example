# Copy to .env (gitignored). Only needed for explicitly approved hosted actions.
# Never commit real values.

# Gemini Developer API (free tier; used only with: run --gemini --approve-live)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# LangSmith
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agenteval-lab
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Opik (Comet cloud)
OPIK_API_KEY=
OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=agenteval-lab

# Braintrust
BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT=agenteval-lab

# Raindrop (write key from app.raindrop.ai)
RAINDROP_WRITE_KEY=
# RAINDROP_PROJECT_ID=
